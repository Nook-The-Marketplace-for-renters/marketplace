# Frontend (Vite) — VITE_-prefixed vars are bundled into the public JS.
# Only ever put values here that are safe for every visitor to see.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps embed (optional) — upgrades the listing detail map from the
# keyless OpenStreetMap embed to Google Maps. Google Cloud Console → Maps Embed API
VITE_GOOGLE_MAPS_API_KEY=

# Google and Apple sign-in are no longer configured here — they now go through
# Supabase Auth directly. Enable each provider in your Supabase dashboard under
# Authentication → Providers (that's where their client IDs/secrets live now).

# ---------------------------------------------------------------------------
# Backend (api/*, server/*) — NEVER prefix these with VITE_. They're read by
# the Vercel serverless functions (Node), not bundled into the browser build.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
